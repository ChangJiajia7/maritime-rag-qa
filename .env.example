# ============================================================
# maritime-rag-qa 环境变量模板（复制为 .env 后填写真实值）
# 规则：.env 已被 .gitignore 排除，绝不提交真实 key。
# 三件套全走 API（本机不装 embedding 模型）：
#   ① LLM 生成    ② 嵌入(embedding)  ③ 重排(rerank)
# 国内可达推荐：嵌入/重排用 SiliconFlow(硅基流动)，生成可用 DeepSeek。
# ============================================================

# ---------- ① LLM 生成（OpenAI 兼容）----------
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-请填入你的密钥
LLM_MODEL=deepseek-chat

# ---------- ② 嵌入 embedding ----------
# SiliconFlow 硅基流动：https://cloud.siliconflow.cn 注册免费额度
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-请填入你的密钥
EMBED_MODEL=BAAI/bge-m3

# ---------- ③ 重排 rerank ----------
# SiliconFlow 提供 bge-reranker 系列
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-请填入你的密钥
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 通用 ----------
# 检索运行参数（app.py 实际消费；分块按「条」切，无 token 长度参数）
# top-k：喂给生成模型的条文数
TOP_K=5
# 混合检索权重 α（1=纯向量, 0=纯BM25）；0.7 为实测最优，见 experiments/log.md A3
MIX_ALPHA=0.7
